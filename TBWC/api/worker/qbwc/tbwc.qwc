<?xml version="1.0"?>
<!--
  TBWC QuickBooks Web Connector config. Import on the Windows PC running QB Desktop:
    Web Connector > File > Add an Application > pick this .qwc

  BEFORE SHIPPING, replace the two <<...>> placeholders:
    <AppURL>   = deployed Worker /qbwc endpoint (https, valid public cert; Cloudflare provides)
    <UserName> = must match the QBWC_USERNAME secret set via `wrangler secret put`

  The QBWC password is NOT in this file — the connector prompts for it on first
  add and stores it; it must match the QBWC_PASSWORD secret.

  OwnerID/FileID are STABLE — generated once for this app. Never change them, or
  the connector treats it as a different app and re-prompts/duplicates.
-->
<QBWCXML>
  <AppName>TBWC QuickBooks Sync</AppName>
  <AppID></AppID>
  <AppURL>https://tbwc-api-production.emilguirguis.workers.dev/qbwc</AppURL>
  <AppDescription>Bidirectional sync between the TBWC portal and QuickBooks Desktop.</AppDescription>
  <AppSupport>https://tbwc.example.com/support</AppSupport>
  <UserName>tbwc</UserName>
  <OwnerID>{ECD85012-F531-450D-AC0A-75A34403D91F}</OwnerID>
  <FileID>{03BB9176-5CFE-45B3-8FD6-EA2D24BE79A8}</FileID>
  <QBType>QBFS</QBType>
  <Scheduler>
    <RunEveryNSeconds>300</RunEveryNSeconds>
  </Scheduler>
</QBWCXML>
