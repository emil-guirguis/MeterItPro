{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "lib": ["ES2020", "DOM"],
    "types": ["node"]
  },
  "include": ["worker/**/*"],
  "exclude": ["node_modules", "dist", "dist-worker"]
}
