# ============================================================================
# JWT CONFIGURATION
# ============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
# DEV DEBUGGING — remove before production
# ============================================================================
# Check if a meter goes offline immediately after a read (helps diagnose if
# BACnet reads are crashing the device). Set to true to enable, false to disable.
BACNET_DEBUG_POST_READ_CHECK=true

