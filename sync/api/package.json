{
  "name": "meteritpro-sync-api",
  "version": "1.0.0",
  "description": "Backend API for MeterIt Pro Sync Service",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=../../.env dist/server.js",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "dev:node": "npm run build && node --env-file=../../.env dist/server.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^20.19.25",
    "@types/pg": "^8.15.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "tsx": "^4.19.4",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  },
  "keywords": [
    "sync",
    "api",
    "postgresql",
    "express"
  ],
  "author": "",
  "license": "MIT"
}
