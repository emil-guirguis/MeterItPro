# Sync MCP Configuration - Development

# Client System API Configuration
CLIENT_API_URL=http://localhost:8787/api

# Sync Configuration
SYNC_INTERVAL_MINUTES=5
BATCH_SIZE=1000
MAX_RETRIES=5

# Local API Server Configuration (for Sync Frontend)
LOCAL_API_PORT=3002

# BACnet Configuration
BACNET_INTERFACE=0.0.0.0
BACNET_PORT=47808

# Meter Reading Cleanup Configuration
METER_READING_RETENTION_DAYS=60  # Delete readings older than 60 days (2 months)
METER_READING_CLEANUP_AUTO_START=true  # Run cleanup on startup

# Logging Configuration
LOG_LEVEL=info

# Development Settings
NODE_ENV=development
