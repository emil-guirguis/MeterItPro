# Copy this file to .env in the sync/ directory and fill in values.
# This file is a template — do NOT commit .env with real secrets.

# ── GitHub Container Registry ─────────────────────────────────────────────────
# Your GitHub username or org that owns the packages
GITHUB_OWNER=your-github-username

# ── PostgreSQL (local sync database) ──────────────────────────────────────────
POSTGRES_SYNC_DB=meterit
POSTGRES_SYNC_USER=meterituser
POSTGRES_SYNC_PASSWORD=changeme-use-strong-password

# ── Remote Client API ──────────────────────────────────────────────────────────
CLIENT_API_URL=https://meteritpro.com/api
CLIENT_API_KEY=

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme-use-strong-random-string

# ── MCP ────────────────────────────────────────────────────────────────────────
MCP_HTTP_PORT=3003
BACNET_DEBUG_POST_READ_CHECK=false
