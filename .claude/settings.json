{
  "hooks": {
    "PostToolUse": [{
      "matcher": "Edit|Write",
      "hooks": [{"type": "command", "command": "npx tsc --noEmit -p . 2>&1 | head -30"}]
    }]
  },
  "permissions": {
    "allow": [
      "Bash(curl:*)",
      "Bash(echo \"EXIT: $?\")",
      "Bash(netstat -ano)",
      "Bash(git checkout HEAD -- .env)",
      "Bash(taskkill /PID 14296 /F)",
      "Bash(cmd /c \"taskkill /PID 14296 /F\")",
      "Bash(git show *)"
    ],
    "additionalDirectories": [
      "c:\\Projects\\MeterItPro"
    ]
  }
}
