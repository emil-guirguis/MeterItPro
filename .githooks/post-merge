#!/bin/bash
# post-merge: auto-build sync components after git pull
# Runs automatically when `git pull` merges new commits.

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo ""
echo "================================================="
echo "  MeterItPro: Auto-build after git pull"
echo "================================================="

# ── Helper: check if any package.json changed in a path ──────────────────────
changed_files() {
  git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD 2>/dev/null || true
}

CHANGED="$(changed_files)"

# ── npm install where package.json changed ────────────────────────────────────
if echo "$CHANGED" | grep -q "^MeterItProSync/api/package"; then
  echo "[install] MeterItProSync/api dependencies changed, running npm install..."
  (cd "$REPO_ROOT/MeterItProSync/api" && npm install --silent)
fi

if echo "$CHANGED" | grep -q "^MeterItProSync/mcp/package"; then
  echo "[install] MeterItProSync/mcp dependencies changed, running npm install..."
  (cd "$REPO_ROOT/MeterItProSync/mcp" && npm install --silent)
fi

if echo "$CHANGED" | grep -q "^MeterItProSync/frontend/package"; then
  echo "[install] MeterItProSync/frontend dependencies changed, running npm install..."
  (cd "$REPO_ROOT/MeterItProSync/frontend" && npm install --silent)
fi

# ── Build MeterItProSync/api ─────────────────────────────────────────────────────────────
echo ""
echo "[1/3] Building MeterItProSync/api (TypeScript)..."
if (cd "$REPO_ROOT/MeterItProSync/api" && npm run build); then
  echo "      MeterItProSync/api built OK"
else
  echo "      ERROR: MeterItProSync/api build failed" >&2
  exit 1
fi

# ── Build MeterItProSync/mcp ─────────────────────────────────────────────────────────────
echo ""
echo "[2/3] Building MeterItProSync/mcp (TypeScript)..."
if (cd "$REPO_ROOT/MeterItProSync/mcp" && npm run build); then
  echo "      MeterItProSync/mcp built OK"
else
  echo "      ERROR: MeterItProSync/mcp build failed" >&2
  exit 1
fi

# ── Build MeterItProSync/frontend ───────────────────────────────────────────────────────
echo ""
echo "[3/3] Building MeterItProSync/frontend (Vite)..."
if (cd "$REPO_ROOT/MeterItProSync/frontend" && npm run build); then
  echo "      MeterItProSync/frontend built OK"
else
  echo "      ERROR: MeterItProSync/frontend build failed" >&2
  exit 1
fi

# ── Restart Windows services ──────────────────────────────────────────────────
echo ""
echo "[restart] Restarting Windows services (requires Administrator terminal)..."

SCRIPT_PATH="$(cygpath -w "$REPO_ROOT/scripts/restart-services.js" 2>/dev/null || echo "$REPO_ROOT/scripts/restart-services.js")"

# Try direct restart (works if terminal is already elevated)
if node "$REPO_ROOT/scripts/restart-services.js" 2>/dev/null; then
  echo "         Services restarted OK"
else
  echo "         NOTE: Run 'npm run services:restart' from an Administrator terminal to restart services"
fi

echo ""
echo "================================================="
echo "  Build complete!"
echo "  Sync API:      http://localhost:3002"
echo "  Sync Frontend: http://localhost:3003"
echo "================================================="
echo ""
