{
  "name": "meteritpro-api",
  "version": "1.0.0",
  "description": "Backend API for MeterIt Pro",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "db:migrate": "node migrations/run-migrations.js",
    "db:migrate:extend-meterreadings": "node scripts/extend-meterreadings.js",
    "db:test:stats": "node scripts/test-stats-sql.js",
    "email:setup": "node scripts/setup-email-system.js",
    "email:setup:reset": "node scripts/setup-email-templates.js --reset",
    "templates:seed": "node scripts/manage-templates.js seed",
    "templates:health": "node scripts/manage-templates.js health",
    "templates:repair": "node scripts/manage-templates.js repair",
    "templates:list": "node scripts/manage-templates.js list",
    "templates:stats": "node scripts/manage-templates.js stats",
    "email:test": "node scripts/setup-email-system.js --test",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@types/pg": "^8.15.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "isomorphic-dompurify": "^2.28.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.10.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.3",
    "speakeasy": "^2.0.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/joi": "^17.2.2",
    "@types/node": "^20.0.0",
    "fast-check": "^4.5.3",
    "hono": "^4.11.9",
    "jest": "^30.2.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0",
    "wrangler": "^4.64.0"
  },
  "keywords": [
    "facility-management",
    "api",
    "postgresql",
    "express"
  ],
  "author": "",
  "license": "MIT"
}
